      "weight_loss_10lb",
      "hip_fracture_history"
    ],
    "eligibility_optional_fields": [
      "weight_kg",
      "self_rated_health",
      "smoking_current",
      "drinking_any",
      "exercise_regular"
    ],
    "fields": {
      "age": {
        "source": "vital.AGEINT87",
        "unit": "years",
        "missing": "outside 65..98 excluded"
      },
      "sex_male": {
        "source": "vital.SEXSUBJ",
        "mapping": {
          "1": 1,
          "2": 0
        }
      },
      "weight_kg": {
        "source": "1987.WEIGHNOW",
        "source_unit": "self-reported pounds",
        "conversion": "lb * 0.45359237",
        "valid_source_range": [
          55,
          700
        ]
      },
      "self_rated_health": {
        "source": "1987.GENERAL",
        "valid_range": [
          1,
          5
        ],
        "meaning": "1 excellent through 5 poor"
      },
      "smoking_current": {
        "source": [
          "1987.SMOKENOW",
          "1987.CSMKNOW",
          "1987.SMOKE100"
        ],
        "mapping": "1 yes, 2 no; screening no implies not current"
      },
      "drinking_any": {
        "source": "1987.DRINKYR",
        "mapping": "1 yes, 2 no; at least one drink in previous year"
      },
      "high_cholesterol_history": {
        "source": "1987.HIGHBLCH",
        "mapping": "1 yes -> 1; 2 no -> 0; 95 borderline and missing -> null",
        "meaning": "doctor-told high cholesterol before or at baseline; not a measured lipid value",
        "codebook": "1987intv.pdf page 115 (printed 111)"
      },
      "health_worsened": {
        "source": "1987.HEALTH",
        "mapping": "1 improved, 2 same -> 0; 3 gradually worsened, 4 suddenly worsened -> 1; other -> null",
        "meaning": "health change during 12 months before baseline",
        "codebook": "1987intv.pdf page 144 (printed 140)"
      },
      "weight_gain_10lb": {
        "source": "1987.WHTCOMPR",
        "mapping": "1 -> 1; 2,3 -> 0; other -> null",
        "meaning": "self-reported gain of at least 10 pounds over preceding 12 months",
        "codebook": "1987intv.pdf page 204 (printed 200)"
      },
      "weight_loss_10lb": {
        "source": "1987.WHTCOMPR",
        "mapping": "2 -> 1; 1,3 -> 0; other -> null",
        "meaning": "self-reported loss of at least 10 pounds over preceding 12 months",
        "codebook": "1987intv.pdf page 204 (printed 200)"
      },
      "hip_fracture_history": {
        "source": [
          "1987.BROKENHI",
          "1987.BRKNHIP"
        ],
        "mapping": "prior 1 or current 1 -> 1; current 2 -> 0; skipped/unknown otherwise -> null",
        "codebook": "1987intv.pdf page 127 (printed 123)"
      },
      "exercise_regular": {
        "source": "1987.EXERPROG",
        "mapping": "1 yes, 2 no; regular exercise or sports"
      }
    },
    "history_features": [
      "hypertension",
      "diabetes",
      "stroke",
      "heart_attack",
      "osteoporosis"
    ],
    "target_history_excluded_from_own_model": true,
    "preprocessing": "fold-local median imputation + missing indicators + standard scaling; bundled with calibrated estimator",
    "temporal_rule": "all inputs known at baseline; no followup measurements or outcomes used as predictors"
  }
