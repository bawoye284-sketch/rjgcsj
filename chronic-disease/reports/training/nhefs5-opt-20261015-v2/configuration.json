    ],
    "minimum_optional_inputs": 2,
    "optional_profile": [
      "weight_kg",
      "self_rated_health",
      "smoking_current",
      "drinking_any",
      "exercise_regular",
      "high_cholesterol_history",
      "health_worsened",
